# Normalize all text files to LF in the repository
*           text=auto
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.go        text eol=lf
*.rb        text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf diff=xml
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf diff=json
*.md        text eol=lf diff=markdown linguist-detectable
*.txt       text eol=lf
*.htm       text eol=lf diff=html
*.html      text eol=lf diff=html
*.css       text eol=lf diff=css
*.php       text eol=lf diff=php
*.sql       text eol=lf diff=sql
*.js        text eol=lf diff=javascript
*.ts        text eol=lf diff=javascript
*.jsx       text eol=lf diff=javascript
*.tsx       text eol=lf diff=javascript

# Files that must use CRLF on checkout
*.csv       text eol=crlf
*.ps1       text eol=crlf
*.[cC][mM][dD]  text eol=crlf
*.[bB][aA][tT]  text eol=crlf

# These files are text and should have LF line endings on checkout
.gitattributes  text
.gitignore      text
.gitmodules     text

# Fix syntax highlighting on GitHub/Forgejo to allow comments
.vscode/*.json  linguist-language=JSON-with-Comments

# Configs
package.json        text eol=lf
package-lock.json   text eol=lf -diff
pnpm-lock.yaml      text eol=lf -diff

# Other Text-based Assets
*.svg       text

# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.psd       binary
*.ai        binary

# Compiled objects and archives
*.a         binary
*.o         binary
*.so        binary
*.dylib     binary
*.dll       binary
*.exe       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.tgz       binary
*.7z        binary
*.bz        binary
*.bz2       binary
*.bzip2     binary
*.rar       binary
*.txz       binary
*.xz        binary

# Office documents
*.pdf       binary
*.doc       binary
*.docx      binary
*.xls       binary
*.xlsx      binary
*.ppt       binary
*.pptx      binary

# SQLite databases
*.db        binary
*.sqlite    binary
*.sqlite3   binary

# Fonts
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary

# Text files where line endings should be preserved
*.patch -text
